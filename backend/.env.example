PORT=3000
CORS_ORIGIN=http://localhost:4200
# Local (Docker):
MONGODB_URI=mongodb://127.0.0.1:27017/maxsend
# MongoDB Atlas (reemplazá usuario, contraseña y cluster; el nombre de la base va después de la "/"):
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.xxxxx.mongodb.net/maxsend?retryWrites=true&w=majority
# Generá uno largo y aleatorio, por ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame
JWT_EXPIRES_IN=15m

# Cuentas de prueba que crea `npm run seed`
SEED_ADMIN_EMAIL=admin@maxsend.test
SEED_ADMIN_PASSWORD=CambiaMe123
SEED_USER_EMAIL=demo@maxsend.test
SEED_USER_PASSWORD=CambiaMe123
